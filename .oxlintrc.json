{
    // https://oxc.rs/docs/guide/usage/linter/config.html
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "options": {
        "typeAware": true,
        "typeCheck": true
    },
    "categories": {
        "perf": "error",
        "suspicious": "error"
    },
    "rules": {
        "typescript/no-unsafe-type-assertion": "allow",
        "unicorn/prefer-node-protocol": "error"
    }
}
